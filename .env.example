# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (Atlas → Connect → Drivers). The free M0 tier works.
# In Atlas → Network Access, allow 0.0.0.0/0 so Vercel's serverless functions can connect.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=datblob"
MONGODB_DB="datblob"

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public base URL of the app (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"

# ─── GitHub OAuth (optional — the button is hidden when unset) ───────────────
# Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Maintenance ─────────────────────────────────────────────────────────────
# Vercel sends this as a Bearer token to /api/cron/purge. openssl rand -hex 24
CRON_SECRET=""
# Optional; HMAC key for rate-limit counters. Falls back to BETTER_AUTH_SECRET.
RATE_LIMIT_SECRET=""

# ─── Encryption at rest ──────────────────────────────────────────────────────
# Master key that wraps each chat's data key. 32 bytes, base64: openssl rand -base64 32
# Keep it out of the database and back it up separately. Losing it makes live chats unreadable.
DATA_ENCRYPTION_KEY=""
